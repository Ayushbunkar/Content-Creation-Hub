# =======================================================
# LOCAL AI VIDEO STUDIO & SOCIAL PUBLISHING PIPELINE
# =======================================================

# Port & Base URL
PORT=3000
APP_BASE_URL=http://127.0.0.1:3000

# Vault Encryption Key (Optional - if omitted, auto-generated in storage/.vault.key)
# Must be at least 32 characters
APP_ENCRYPTION_KEY=your_strong_random_secret_encryption_key_32chars

# =======================================================
# YOUTUBE DATA API v3 (GOOGLE OAUTH 2.0)
# =======================================================
# Create credentials in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Scopes:
#   - https://www.googleapis.com/auth/youtube.upload
#   - https://www.googleapis.com/auth/youtube.readonly
#   - https://www.googleapis.com/auth/userinfo.profile
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/social/oauth/google/callback

# =======================================================
# INSTAGRAM CONTENT PUBLISHING API (META FOR DEVELOPERS)
# =======================================================
# Create app in Meta for Developers:
# https://developers.facebook.com/apps
# Required permissions:
#   - instagram_basic
#   - instagram_content_publish
#   - pages_show_list
#   - pages_read_engagement
# Note: Instagram account must be Professional (Creator or Business) linked to a Facebook Page.
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_REDIRECT_URI=http://127.0.0.1:3000/api/social/oauth/meta/callback
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id

# =======================================================
# PUBLIC MEDIA HOSTING (REQUIRED FOR INSTAGRAM REELS)
# =======================================================
# Meta's Instagram API downloads the video file over HTTPS.
# Choose ONE of the following options:

# Option A: Public Tunnel / Domain (e.g. ngrok, localtunnel, Cloudflare Tunnel, or VPS domain)
PUBLIC_APP_URL=https://your-domain-or-tunnel.ngrok-free.app

# Option B: S3 Compatible Storage (AWS S3, Cloudflare R2, MinIO, Wasabi)
# S3_BUCKET=my-reels-upload-bucket
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_aws_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret

# Option C: Cloudinary
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
