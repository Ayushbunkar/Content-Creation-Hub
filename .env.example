# =======================================================
# LOCAL AI VIDEO STUDIO & SOCIAL PUBLISHING PIPELINE
# =======================================================

PORT=3000
APP_BASE_URL=http://127.0.0.1:3000

# =======================================================
# YOUTUBE DATA API v3 (GOOGLE OAUTH 2.0)
# =======================================================
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/api/social/oauth/google/callback

# =======================================================
# INSTAGRAM CONTENT PUBLISHING API (META FOR DEVELOPERS)
# =======================================================
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_REDIRECT_URI=http://localhost:3000/api/social/oauth/meta/callback
